[Unit]
Description=Network Name Resolution
Documentation=man:systemd-resolved(8)
Documentation=https://www.freedesktop.org/software/systemd/man/systemd-resolved.html
Documentation=https://www.freedesktop.org/software/systemd/man/resolvectl.html

[Resolve]
{% if common_dns_enable_cache | default(true) %}DNSCache=yes{% else %}DNSCache=no{% endif %}

{% if common_dns_servers is defined %}
DNS=
{% for server in common_dns_servers %}
  {{ server }}
{% endfor %}
{% endif %}

{% if common_dns_use_doh %}
DNSOverHTTPS=yes
{% endif %}

[DNSStubListener]
{% if common_dns_listen_ports is defined %}
ListenStub=127.0.0.53:53{% for port in common_dns_listen_ports if port != 53 %} 127.0.0.53:{{ port }}{% endfor %}
{% else %}
ListenStub=
{% endif %}

[Cache]
NegativeDNSResponses=60s